model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  stock       Int      @default(0)
  merchantId  String
  merchant    Merchant @relation(fields: [merchantId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
